# Example env for local development
# If you run docker compose (docker-compose.yml) the DB URL inside containers is:
#   postgres://postgres:postgres@db:5432/fastfood
# For running migrations from host, use localhost:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fastfood

# JWT secret used by the API (for local/dev only)
JWT_SECRET=dev_jwt_secret

PORT=3000
